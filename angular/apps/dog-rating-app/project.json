{
  "name": "dog-rating-app",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dog-rating-app/src",
  "prefix": "app",
  "tags": [
    "type:app",
    "scope:dog-rating-app"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": {
          "base": "dist/apps/dog-rating-app"
        },
        "index": "apps/dog-rating-app/src/index.html",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/dog-rating-app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/dog-rating-app/src/favicon.ico",
          "apps/dog-rating-app/src/assets"
        ],
        "styles": [
          "apps/dog-rating-app/src/styles.css",
          "node_modules/ngx-toastr/toastr.css"
        ],
        "scripts": [],
        "browser": "apps/dog-rating-app/src/main.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "libs/shared/util-environments/src/lib/environment.ts",
              "with": "libs/shared/util-environments/src/lib/environment.prod.ts"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "styles": {
              "inlineCritical": false
            }
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dog-rating-app:build:production"
        },
        "development": {
          "buildTarget": "dog-rating-app:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "dog-rating-app:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/dog-rating-app/jest.config.ts"
      }
    }
  }
}
