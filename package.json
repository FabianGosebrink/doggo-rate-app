{
  "name": "@dog-rate-app/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve dog-rate-app --configuration=development",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "test": "nx run-many -t test --coverage && npm run summarize:coverage",
    "test:watch": "nx run-many -t test --watch",
    "test:affected": "nx affected -t test",
    "graph": "nx graph",
    "graph:affected": "nx graph --affected",
    "build": "nx build dog-rate-app",
    "build-temp": "nx build dog-rate-app --skip-nx-cache",
    "build-dev": "nx build --configuration development",
    "build-desktop": "node tools/build-desktop.js",
    "build-mobile": "node tools/build-mobile.js",
    "summarize:coverage": "node tools/create-overall-coverage.js",
    "show:projects": "nx show projects",
    "prettier": "prettier --write .",
    "run:be": "nx run dotnet-dog-api --launchProfile=http",
    "build:be": "nx build dotnet-dog-api -- --configuration Release --output ./dist/apps/dotnet-dog-api",
    "publish:be": "nx publish dotnet-dog-api -- --output ./dist/apps/dotnet-dog-api",
    "run:be:https": "nx run dotnet-dog-api --launchProfile=https",
    "start:all": "nx run-many --targets=serve,watch --projects=dog-rate-app,dotnet-dog-api --parallel=true"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.14",
    "@angular/common": "21.2.14",
    "@angular/compiler": "21.2.14",
    "@angular/core": "21.2.14",
    "@angular/forms": "21.2.14",
    "@angular/platform-browser": "21.2.14",
    "@angular/router": "21.2.14",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/toast": "^8.0.0",
    "@microsoft/signalr": "^10.0.0",
    "@ngrx/operators": "^21.0.0",
    "@ngrx/signals": "^21.0.0",
    "angular-auth-oidc-client": "^21.0.1",
    "base64-arraybuffer": "^1.0.2",
    "ngx-toastr": "^19.1.0",
    "rxjs": "~7.8.0",
    "shelljs": "^0.10.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.1.2",
    "@analogjs/vitest-angular": "~2.1.2",
    "@angular-devkit/core": "21.2.13",
    "@angular-devkit/schematics": "21.2.13",
    "@angular/build": "21.2.13",
    "@angular/cli": "21.2.13",
    "@angular/compiler-cli": "21.2.14",
    "@angular/language-service": "21.2.14",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.3.1",
    "@nx/devkit": "22.3.1",
    "@nx/dotnet": "^22.3.1",
    "@nx/eslint": "22.3.1",
    "@nx/eslint-plugin": "22.3.1",
    "@nx/js": "22.3.1",
    "@nx/playwright": "22.3.1",
    "@nx/vite": "22.3.1",
    "@nx/vitest": "22.3.1",
    "@nx/web": "22.3.1",
    "@nx/workspace": "22.3.1",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~21.0.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "angular-eslint": "^21.0.1",
    "electron": "^39.2.7",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "~22.1.0",
    "ng-mocks": "^14.15.0",
    "nx": "22.3.1",
    "nyc": "^17.1.0",
    "prettier": "~3.6.2",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
